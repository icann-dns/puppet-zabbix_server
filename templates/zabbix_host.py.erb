#!/usr/bin/env python3
import argparse
import json
import socket
import sys

from pathlib import Path

import pyzabbix
import yaml
# Uncomment for debugging
#import logging
#logger = logging.getLogger("pyzabbix")
#logger.setLevel(logging.DEBUG)
#handler = logging.StreamHandler(sys.stdout)
#logger.addHandler(handler)


def get_args():
    parser = argparse.ArgumentParser(description='add a host to zabbix')

    parser.add_argument('-c', '--config-file', default='/etc/zabbix/api.yaml', help='path to api config', type=Path)
    parser.add_argument('-g', '--group-ids', default='<%= @default_group_ids %>', help='Group IDs for host')
    parser.add_argument('-t', '--template-ids', default='<%= @default_template_ids %>', help='Template IDs for host')
    parser.add_argument('--exists', help='check if the host exists', action='store_true')
    parser.add_argument('--update', help='update host setting', action='store_true')
    parser.add_argument('--delete', help='delete the host', action='store_true')
    parser.add_argument('--node', help='the node to add')
    return parser.parse_args()


def get_interfaces(node):
    main = 1
    interfaces = []
    snmp_details = {
        'version': 2,
        'community': '{$SNMP_COMMUNITY}'
    }
    for addr_info in socket.getaddrinfo(node, 80, 0, 0, socket.SOL_TCP):
        if "drac" in node:
            interface = {
                'type': 2,
                'main': main,
                'useip': 1,
                'ip': addr_info[4][0],
                'dns': node,
                'port': 161,
                'details': snmp_details
            }
        else:
            interface = {
                'type': 1,
                'main': main,
                'useip': 1,
                'ip': addr_info[4][0],
                'dns': node,
                'port': 10050
            }
        interfaces.append(interface)
        main = 0
    return interfaces


def main():

    args = get_args()
    config = yaml.safe_load(args.config_file.read_text())
    zapi = pyzabbix.ZabbixAPI(config['server'])

    # Login to the Zabbix API
    zapi.login(config['username'], config['password'])
    # current_config = zapi.host.get(filter = { 'host' : args.node })
    if args.node:
        current_config = zapi.host.get(
                filter={'host': args.node},
                output=['hostid', 'host'],
                selectGroups='shorten', selectParentTemplates='shorten')
    else:
        current_config = zapi.host.get(output=['hostid', 'host'],
              selectGroups='shorten', selectParentTemplates='shorten')

    groups = []
    templates = []
    for group_id in args.group_ids.split(','):
        groups.append({'groupid': group_id})
    for template_id in args.template_ids.split(','):
        templates.append({'templateid': template_id})

    if args.exists:
        if current_config:
            # There should only be one element in the array
            print(json.dumps(current_config))
        else:
            print('{}')
        sys.exit()
    if current_config:
        for host in current_config:
            if args.delete and args.node:
                result = zapi.host.delete(hostid=host['hostid'])
            else:
                result = zapi.host.update(
                        hostid=host['hostid'],
                        groups=groups,
                        templates=templates,)
    else:
        try:
            interfaces = get_interfaces(args.node)
            result = zapi.host.create( # noqa
                    host=args.node,
                    interfaces=interfaces,
                    groups=groups,
                    templates=templates,)
        except: # noqa
            pass


if __name__ == "__main__":
    main()
